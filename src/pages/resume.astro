---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { group: 'Languages', items: 'Python, Java, Shell, JavaScript, TypeScript' },
  { group: 'Cloud & Containers', items: 'Azure (AKS), AWS, GCP, Kubernetes, Docker, Helm, Terraform, PCF' },
  { group: 'AI & Automation', items: 'GitHub Copilot, Copilot CLI, LLM-assisted system design and code review, agentic AI workflows, end-to-end delivery automation' },
  { group: 'Messaging/Streaming', items: 'Kafka, Kafka Connect, Kafka Streams' },
  { group: 'Frameworks', items: 'FastAPI, Spring Boot, Flask, Angular, AWS Lambda, API Gateway' },
  { group: 'Databases', items: 'PostgreSQL, Oracle' },
  { group: 'Practices', items: 'Distributed Systems, Multicloud, IaC, CDC, CI/CD, Microservices, DR/Failover, Vulnerability Management' },
];
---

<BaseLayout title="Resume | Himanshu Singh" description="Resume for Himanshu Singh, Senior Software Engineer focused on platform engineering, cloud infrastructure, Kafka, Kubernetes, and automation.">
  <section class="page-header">
    <div class="container reading">
      <p class="eyebrow">Resume</p>
      <h1>Himanshu Singh</h1>
      <p class="lead">Senior Software Engineer with 9+ years building distributed systems and cloud-native infrastructure across Azure, AWS, and GCP. Deep expertise in Kafka, Kubernetes, and infrastructure-as-code, with a track record of reducing migration and provisioning times from days to hours.</p>
      <div class="button-row">
        <a class="button button-primary" href="/resume.pdf" download>Download PDF</a>
        <a class="button" href="/contact/">Contact Himanshu</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-column grid">
      <div class="stack-lg">
        <section class="card stack" aria-labelledby="experience-heading">
          <h2 id="experience-heading">Experience</h2>
          <ul class="split-list">
            <li class="stack">
              <div>
                <h3>Senior Software Engineer</h3>
                <p class="muted"><strong>Microsoft</strong> · Jan 2025 – Present · Noida, India</p>
              </div>
              <ul>
                <li>Drive infrastructure for malware analysis and remediation within Microsoft Security, designing ephemeral, fully isolated sandboxes across dedicated Azure tenants detached from Microsoft's corporate environment.</li>
                <li>Consolidated fragmented research environments into a self-service lab platform where researchers compose the tooling they need while the team owns provisioning, vulnerability management, and continuous patching.</li>
                <li>Lead the multicloud effort extending an Azure-native AKS provisioning service to GCP and AWS while adopting each provider's native patterns.</li>
                <li>Freed internal compute capacity for revenue-generating and external-customer workloads by routing usage to best-fit clouds, improving infrastructure cost efficiency.</li>
                <li>Built end-to-end automation across design, delivery, and review workflows using GitHub Copilot and Copilot CLI, compressing delivery cycles from months to days.</li>
              </ul>
            </li>
            <li class="stack">
              <div>
                <h3>Lead Software Engineer</h3>
                <p class="muted"><strong>JP Morgan Chase</strong> · Jan 2024 – Dec 2024 · Bangalore, KA</p>
              </div>
              <ul>
                <li>Played a major role in facilitating Sybase exit for legacy applications by creating robust pipelines for Debezium CDC connectors.</li>
                <li>Facilitated data movement to AWS PostgreSQL using JDBC connectors by creating custom config providers to support JPMC-specific authentication mechanisms.</li>
              </ul>
            </li>
            <li class="stack">
              <div>
                <h3>Software Engineer III</h3>
                <p class="muted"><strong>JP Morgan Chase</strong> · Jan 2022 – Dec 2023 · Bangalore, KA</p>
              </div>
              <ul>
                <li>Increased AWS MSK adoption by 30% across the firm by creating a fully managed replication service for migrating data from on-prem clusters to MSK.</li>
                <li>Reduced datacenter cluster migration time from 15 days to 1 hour via a fully automated namespace migration pipeline.</li>
              </ul>
            </li>
            <li class="stack">
              <div>
                <h3>Software Engineer II</h3>
                <p class="muted"><strong>JP Morgan Chase</strong> · Jan 2021 – Dec 2021 · Bangalore, KA</p>
              </div>
              <ul>
                <li>Reduced time and resource utilization for data-source migration by 80% by building a Kafka Connect control plane supporting 30+ source and sink connectors.</li>
                <li>Built an orchestrator microservice for building, patching, and maintaining Kafka clusters, cutting build-and-patch time from 2 days to 2 hours.</li>
              </ul>
            </li>
            <li class="stack">
              <div>
                <h3>Associate</h3>
                <p class="muted"><strong>JP Morgan Chase</strong> · Jul 2017 – Dec 2020 · Bangalore, KA</p>
              </div>
              <ul>
                <li>Created a monitoring framework for canary health checks on Apache Kafka clusters producing a real-time cluster health index used by 12,000+ applications for failover to DR cluster.</li>
                <li>Created a pipeline for automatic certificate renewal of Kafka cluster hosts; cut manual time from 1 day to 5 minutes and renews 1,500+ certificates for Linux hosts.</li>
              </ul>
            </li>
          </ul>
        </section>

        <section class="card stack" aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <ul class="split-list">
            <li>
              <strong>VIT University, Vellore Institute of Technology</strong><br />
              <span class="muted">B.Tech, Computer Science · Jun 2017 · Vellore, India · GPA 8.66/10.0</span>
            </li>
          </ul>
        </section>
      </div>

      <aside class="stack-lg">
        <section class="card stack" aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <div class="stack">
            {skills.map((skill) => (
              <div class="stack">
                <h3>{skill.group}</h3>
                <p class="muted">{skill.items}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="card stack" aria-labelledby="certifications-heading">
          <h2 id="certifications-heading">Certifications</h2>
          <ul class="split-list">
            <li><strong>HashiCorp Certified Terraform Associate</strong><br /><span class="muted">Dec 2022</span></li>
            <li><strong>Certified Kubernetes Application Developer / CKAD</strong><br /><span class="muted">Nov 2022</span></li>
            <li><strong>AWS Certified Cloud Practitioner</strong><br /><span class="muted">Aug 2022</span></li>
          </ul>
        </section>

        <section class="card stack" aria-labelledby="awards-heading">
          <h2 id="awards-heading">Awards</h2>
          <ul class="split-list">
            <li><strong>APAC CEO Award</strong><br /><span class="muted">Aug 2023</span></li>
            <li><strong>Reward of Excellence</strong><br /><span class="muted">Jul 2020</span></li>
            <li><strong>Winner, SEP Hackathon</strong><br /><span class="muted">Jul 2018</span></li>
          </ul>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

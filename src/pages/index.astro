---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeader from '../components/SectionHeader.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return Number(b.data.featured) - Number(a.data.featured);
    return a.data.order - b.data.order;
  });
const featuredProjects = projects.slice(0, 3);
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Himanshu Singh | Senior Software Engineer" description="Portfolio for Himanshu Singh, a Senior Software Engineer with 9+ years of experience building distributed systems, multicloud Kubernetes platforms, and streaming infrastructure.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="stack-lg reading">
        <p class="eyebrow">9+ years building distributed systems and cloud-native infrastructure</p>
        <div class="stack">
          <h1>Himanshu Singh</h1>
          <p class="lead">Senior Software Engineer — distributed systems, multicloud Kubernetes &amp; streaming infrastructure</p>
          <p class="muted">I build distributed systems and cloud-native infrastructure across Azure, AWS, and GCP. At Microsoft Security, I work on isolated malware-analysis environments and multicloud Kubernetes provisioning; earlier at JP Morgan Chase, I built Kafka platforms and automation that reduced migrations and provisioning from days to hours.</p>
        </div>
        <div class="button-row" aria-label="Primary actions">
          <a class="button button-primary" href="/projects/">View Projects</a>
          <a class="button" href="/resume.pdf" download>Download Resume</a>
          <a class="button" href="/contact/">Contact Me</a>
        </div>
      </div>
      <aside class="hero-panel" aria-labelledby="proof-heading">
        <p class="eyebrow" id="proof-heading">Recruiter scan</p>
        <dl>
          <div>
            <dt>Current focus</dt>
            <dd>Multicloud Kubernetes provisioning, isolated malware-analysis infrastructure, and platform automation.</dd>
          </div>
          <div>
            <dt>Strongest proof</dt>
            <dd>Migration and provisioning workflows reduced from days to hours, with reliability signals used by 12,000+ applications.</dd>
          </div>
          <div>
            <dt>Stack signal</dt>
            <dd>Python, Java, Kafka, Kubernetes, Docker, Helm, Terraform, Azure, AWS, and GCP.</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionHeader eyebrow="Featured work" title="Open-source projects and things I build in public." description="Personal and community projects — building tools from scratch, learning in public, and sharing the write-ups." />
      <div class="card-grid three">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-column grid">
      <div class="stack-lg">
        <SectionHeader eyebrow="Resume snapshot" title="Skimmable proof for recruiters." description="Senior and lead engineering experience across Microsoft and JP Morgan Chase, with deep work in platform automation, streaming systems, cloud infrastructure, and Kubernetes." />
        <div class="button-row">
          <a class="button button-primary" href="/resume.pdf" download>Download Resume</a>
          <a class="button" href="/resume/">View web resume</a>
        </div>
      </div>
      <aside class="card stack" aria-labelledby="snapshot-heading">
        <h3 id="snapshot-heading">Verified highlights</h3>
        <ul class="split-list">
          <li><strong>Platform engineering</strong><br /><span class="muted">Builds streaming, automation, and cloud infrastructure capabilities used by application and platform teams.</span></li>
          <li><strong>Security &amp; reliability</strong><br /><span class="muted">Secured, isolated environments with observability and reliability built in; ongoing focus on platform security posture.</span></li>
          <li><strong>Cloud and Kubernetes</strong><br /><span class="muted">Works across Azure, AWS, GCP, Kubernetes, Docker, Helm, Terraform, and secured infrastructure workflows.</span></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionHeader eyebrow="Latest writing" title="Thinking in public." description="Notes on building tools from scratch, agentic development, and learning in public for the developer community." />
      <div class="card-grid three">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container card stack-lg">
      <div class="reading stack">
        <p class="eyebrow">Contact</p>
        <h2>Make the next step easy.</h2>
        <p class="lead">Reach out for senior, lead, or staff platform and infrastructure engineering roles focused on distributed systems, cloud platforms, or developer-facing infrastructure.</p>
      </div>
      <div class="button-row">
        <a class="button button-primary" href="mailto:singhhimanshu004@gmail.com" aria-label="Email Himanshu Singh at singhhimanshu004@gmail.com">Email Himanshu</a>
        <a class="button" href="https://www.linkedin.com/in/singhhimanshu004/" target="_blank" rel="noopener noreferrer" aria-label="Himanshu Singh on LinkedIn">LinkedIn</a>
        <a class="button" href="https://github.com/singhhimanshu004" target="_blank" rel="noopener noreferrer" aria-label="Himanshu Singh on GitHub">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
